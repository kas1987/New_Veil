{
  "schema_version": "1.0.0",
  "district_type": "city",
  "properties": {
    "name": {"type": "string", "required": true},
    "display_name": {"type": "string", "required": true},
    "description": {"type": "string", "required": true},
    "surface_function": {"type": "string", "required": true},
    "hidden_function": {"type": "string", "required": true},
    "unlock_conditions": {
      "type": "object",
      "required": true,
      "properties": {
        "min_resonance": {"type": "float", "min": 0.0, "max": 1.0},
        "min_interactions": {"type": "integer", "min": 0},
        "required_emotional_tags": {"type": "array", "items": {"type": "string"}},
        "veil_states_allowed": {"type": "array", "items": {"type": "string"}},
        "veil_states_blocked": {"type": "array", "items": {"type": "string"}}
      }
    },
    "conceals": {"type": "array", "items": {"type": "string"}, "description": "Hidden paths, lore, or agents revealed upon unlock"},
    "npcs": {"type": "array", "items": {"type": "string"}},
    "atmosphere": {"type": "object", "properties": {
      "default_mood": {"type": "string"},
      "veil_state_moods": {"type": "object"}
    }}
  }
}
